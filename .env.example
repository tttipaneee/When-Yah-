# Copy to .env (never commit .env).
API_PORT=8000
WEB_PORT=3000
# Vite dev origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
# Optional: free key from https://developer.tomtom.com — enables "potential traffic" (trip time if you
# leave now / in 15-60 min). Without it the app simply shows no traffic.
TOMTOM_API_KEY=
